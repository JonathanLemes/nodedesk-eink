# NodeDesk E-Ink server settings (all optional).

# Listen address.
NODEDESK_EINK_ADDR=:8421

# Dashboard language: en or pt. The Kindle can override it per request.
NODEDESK_EINK_LANG=en

# Name shown at the top (defaults to the hostname).
#NODEDESK_EINK_NAME=homelab

# Disks to show, as mount=label. Empty = every real filesystem.
# "/" without a label is shown as "System".
#NODEDESK_EINK_DISKS=/=,/mnt/media=Media

# Docker Engine socket, or "off" to hide the Docker card.
#NODEDESK_EINK_DOCKER=/var/run/docker.sock

# Sampling interval for gauges and the one-hour chart.
#NODEDESK_EINK_INTERVAL=10s

# Require ?token=... on every request except /healthz.
#NODEDESK_EINK_TOKEN=
